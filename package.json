{
  "name": "livehere",
  "version": "0.0.3",
  "description": "A tiny, safe-by-default static file server",
  "keywords": [
    "cli",
    "dev-server",
    "live-reload",
    "proxy",
    "serve",
    "server",
    "static",
    "static-files"
  ],
  "homepage": "https://github.com/bin-ran/livehere#readme",
  "bugs": {
    "url": "https://github.com/bin-ran/livehere/issues"
  },
  "license": "MIT",
  "author": "livehere contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bin-ran/livehere.git"
  },
  "bin": {
    "livehere": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./live": {
      "types": "./dist/live.d.mts",
      "import": "./dist/live.mjs"
    },
    "./proxy": {
      "types": "./dist/proxy.d.mts",
      "import": "./dist/proxy.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test scripts",
    "fmt": "oxfmt src test scripts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "verify:meta": "node scripts/check-metadata.mjs",
    "prepublishOnly": "npm run verify:meta && npm run check && npm run build && npm run smoke",
    "pack:check": "npm pack --dry-run",
    "release": "bumpp --no-push",
    "smoke": "node scripts/smoke.mjs",
    "name-check": "node scripts/name-check.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "chokidar": "^6.0.0",
    "citty": "^0.2.2",
    "httpxy": "^0.5.6",
    "mrmime": "^2.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "picocolors": "^1.1.1",
    "publint": "^0.3.25",
    "selfsigned": "^5.5.0",
    "sirv": "^3.0.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.21.0"
}
